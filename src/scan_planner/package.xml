<?xml version="1.0"?>
<package format="3">
  <name>scan_planner</name>
  <version>0.1.0</version>
  <description>Point cloud processing and odometry learning node for 3D navigation.</description>
  <maintainer email="oliveiratang@manifoldtech.cn">tang</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
