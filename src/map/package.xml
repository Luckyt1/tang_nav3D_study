<?xml version="1.0"?>
<package format="3">
  <name>map</name>
  <version>0.1.0</version>
  <description>FreeDOM static maps, motion submaps, and BTC descriptor export for Odin point clouds.</description>
  <maintainer email="oliveiratang@manifoldtech.cn">tang</maintainer>
  <license>MIT</license>
  <!-- BTC upstream does not declare a license; see third_party/btc/NOTICE.md. -->
  <license>LicenseRef-BTC-Unspecified</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <build_depend>libpcl-all-dev</build_depend>
  <exec_depend>libpcl-all</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>std_msgs</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
